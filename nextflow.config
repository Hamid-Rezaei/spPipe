// spPipe configuration

manifest {
    name            = 'spPipe'
    description     = 'Spatial vs expression-only clustering of human DLPFC layers (10x Visium)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

params {
    samplesheet = "${projectDir}/assets/samplesheet.csv"
    outdir      = 'results'

    // QC_FILTER
    min_counts  = 500
    min_genes   = 300
    max_pct_mt  = 30
    min_cells   = 10

    // NORMALIZE
    n_hvg       = 3000

    // CLUSTER_EXPR / CLUSTER_SPATIAL (shared, for a fair comparison)
    n_pcs       = 20
    n_clusters  = 7      // L1-L6 + WM
    n_neighbors = 15

    // CLUSTER_SPATIAL only
    n_rings     = 2      // hexagonal rings of Visium neighbours to average
    lambda      = 0.8    // weight of the neighbourhood (0 = expression-only)

    // SPATIAL_GENES
    n_top_svg   = 20
}

process {
    cpus   = 1
    memory = '2 GB'
    withLabel: 'process_low' {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }
}

// Single-threaded numerics -> identical results run to run
env {
    OMP_NUM_THREADS      = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS      = '1'
    NUMBA_NUM_THREADS    = '1'
    PYTHONHASHSEED       = '0'
    PYTHONWARNINGS       = 'ignore'
}

profiles {
    conda {
        conda.enabled     = true
        conda.channels    = ['conda-forge']
        process.conda     = "${projectDir}/envs/environment.yml"
        conda.createTimeout = '1 h'
        docker.enabled    = false
    }
    docker {
        docker.enabled    = true
        conda.enabled     = false
        process.container = 'sppipe:1.0'
        // run as the host user so files in work/ and results/ are owned by you
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    test {
        params.samplesheet = "${projectDir}/assets/samplesheet_test.csv"
        params.outdir      = 'results_test'
    }
}

// Run reports (overwritten on each run)
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }
